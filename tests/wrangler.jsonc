{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "jsonbin-browser-test",
  "main": "../src/worker/index.ts",
  "compatibility_date": "2026-10-03",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "CACHE", "id": "00000000000000000000000000000000" }
  ],
  "ratelimits": [
    { "name": "JSONBIN_KEY_RATE", "namespace_id": "847621195", "simple": { "limit": 120, "period": 60 } },
    { "name": "JSONBIN_ANON_RATE", "namespace_id": "847621196", "simple": { "limit": 240, "period": 60 } }
  ],
  "r2_buckets": [
    { "binding": "DATA", "bucket_name": "jsonbin-browser-test" }
  ]
}
