{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jsonbin",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-03",
  "keep_vars": true,
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "5761f7b90a4d479b955fa4ac8b69df6e"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "jsonbin-data"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "ApiRateLimiter"
      }
    ]
  },
  "exports": {
    "ApiRateLimiter": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "previews": {
    "durable_objects": {
      "bindings": [
        {
          "name": "RATE_LIMITER",
          "class_name": "ApiRateLimiter"
        }
      ]
    },
    "r2_buckets": [
      {
        "binding": "DATA",
        "bucket_name": "jsonbin-sec002-preview-data"
      }
    ],
    "vars": {
      "ADMIN_USERNAME": "preview-admin",
      "ANALYTICS_EVENTS_SHADOW": "1",
      "ANALYTICS_SHADOW_COMPARE": "1",
      "ANALYTICS_SHADOW_DATASET": "jsonbin-api-shadow-pr20"
    },
    "analytics_engine_datasets": [
      {
        "binding": "ANALYTICS_EVENTS",
        "dataset": "jsonbin-api-shadow-pr20"
      }
    ],
    "analytics": {
      "binding": "ANALYTICS_SQL"
    }
  }
}
