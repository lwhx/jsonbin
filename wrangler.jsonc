{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jsonbin",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-03",
  "keep_vars": true,
  "triggers": { "crons": ["*/15 * * * *"] },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "5761f7b90a4d479b955fa4ac8b69df6e"
    }
  ],
  "ratelimits": [
    { "name": "JSONBIN_KEY_RATE", "namespace_id": "847621193", "simple": { "limit": 120, "period": 60 } },
    { "name": "JSONBIN_ANON_RATE", "namespace_id": "847621194", "simple": { "limit": 240, "period": 60 } }
  ],
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "jsonbin-data"
    }
  ]
}
